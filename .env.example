# Copiez ce fichier en `.env` à la racine du projet (ou à côté de l'exécutable).
# Ne commitez jamais le fichier `.env` contenant vos vraies clés.

# Base de données MySQL
DB_URL=jdbc:mysql://localhost:3306/steevejobs
DB_USER=root
DB_PASSWORD=votre_mot_de_passe_bdd

# Serveur SMTP (ex. Synology MailPlus)
SMTP_URL=smtp://utilisateur:mot_de_passe@mail.votre-domaine.fr:587
EXPEDITEUR=nepasrepondre@votre-domaine.fr

# WebSocket (serveur relais — branche `websocket`, Docker port 8887 en local)
WS_SERVER_IP=notif.votre-domaine.fr
WS_SERVER_PORT=443

# JWT (signature des tokens client ↔ serveur WebSocket)
JWT_SECRET=cle_secrete_longue_et_complexe_pour_jwt

# WebDAV (stockage GED — fichiers PDF, pièces jointes)
WEBDAV_BASE_URL=https://stockage.votre-domaine.fr/chemin/vers/dossier/
WEBDAV_USERNAME=utilisateur_systeme
WEBDAV_PASSWORD=mot_de_passe_webdav

# Front visio (page LiveKit hébergée sur le NAS / reverse proxy)
URL_FRONT_VISIO=https://visio.votre-domaine.fr/index.html
