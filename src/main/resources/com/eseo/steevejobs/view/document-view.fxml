<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="720.0" prefWidth="1280.0"
            style="-fx-background-color: #f4f5f7;" xmlns="http://javafx.com/javafx/11"
            fx:controller="com.eseo.steevejobs.controller.DocumentController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #4B78CC;">
            <padding><Insets left="20.0" right="20.0"/></padding>
            <Label text="GESTION COMMERCIALE" textFill="WHITE">
                <font><Font name="System Bold" size="24.0"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnNouveauDoc" onAction="#ouvrirFormulaireCreation"
                    text="+ Nouveau document"
                    style="-fx-background-color: white; -fx-text-fill: #4B78CC;
                           -fx-font-weight: bold; -fx-background-radius: 20;
                           -fx-cursor: hand; -fx-padding: 8 16;"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="15.0">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>

            <!-- LISTE DES DOCUMENTS -->
            <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></padding>

                <!-- FILTRES -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <TextField fx:id="searchField" promptText="Rechercher un client..." prefWidth="250.0"
                               onKeyReleased="#filtrer" style="-fx-background-radius: 20; -fx-padding: 8 12;"/>
                    <ComboBox fx:id="comboTypeFiltre" promptText="Tous les types" prefWidth="180.0"
                              onAction="#filtrer" style="-fx-background-radius: 20;"/>
                    <ComboBox fx:id="comboStatutFiltre" promptText="Tous les statuts" prefWidth="180.0"
                              onAction="#filtrer" style="-fx-background-radius: 20;"/>
                </HBox>

                <!-- ESPACE ENTRE FILTRES ET TABLEAU -->
                <VBox spacing="10.0">
                    <padding><Insets top="10.0"/></padding>
                </VBox>

                <!-- TABLEAU -->
                <TableView fx:id="tableDocuments" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colType" text="TYPE" prefWidth="140.0"/>
                        <TableColumn fx:id="colClient" text="CLIENT" prefWidth="220.0"/>
                        <TableColumn fx:id="colDate" text="DATE" prefWidth="120.0"/>
                        <TableColumn fx:id="colHT" text="HT" prefWidth="110.0"/>
                        <TableColumn fx:id="colTTC" text="TTC" prefWidth="110.0"/>
                        <TableColumn fx:id="colStatut" text="STATUT" prefWidth="120.0"/>
                        <TableColumn fx:id="colActions" text="" prefWidth="80.0"/>
                    </columns>
                    <placeholder>
                        <Label text="📄 Aucun document trouvé" style="-fx-text-fill: #9ca3af; -fx-font-size: 14px;"/>
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_LEFT" prefHeight="40.0">
                    <Label fx:id="lblNbDocs" text="0 document(s)" textFill="#6b7280" style="-fx-font-size: 12px;"/>
                </HBox>
            </VBox>

            <!-- PANNEAU DÉTAIL -->
            <VBox prefWidth="350.0" style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <!-- ENTÊTE DÉTAIL -->
                <VBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #aebce1; -fx-background-radius: 10 10 0 0;">
                    <padding><Insets left="20.0"/></padding>
                    <Label fx:id="detailType" style="-fx-text-fill: black; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="12.0">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="15.0"/></padding>

                    <!-- CLIENT -->
                    <Label fx:id="detailClient" textFill="#4b5563" style="-fx-font-size: 14px;"/>

                    <Separator/>

                    <!-- INFORMATIONS (titre en noir) -->
                    <Label text="Informations" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: black;"/>

                    <GridPane vgap="10.0" hgap="10.0">
                        <Label text="Date" textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="detailDate" textFill="#333333" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Total HT" textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="detailHT" textFill="#333333" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Total TTC" textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="detailTTC" textFill="#333333" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Statut" textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Label fx:id="detailStatut" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    </GridPane>

                    <Separator/>

                    <!-- LIGNES PRODUITS (titre en noir) -->
                    <Label text="Lignes produits" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: black;"/>
                    <VBox fx:id="lignesContainer" spacing="8.0"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <!-- BOUTONS -->
                    <Button fx:id="btnExporterPdf" onAction="#exporterPdf" maxWidth="Infinity" text="📄 Exporter en PDF"
                            style="-fx-background-color: #4B78CC; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 0;"/>
                    <Button fx:id="btnOuvrirPdf" onAction="#ouvrirPdf" maxWidth="Infinity" text="📂 Ouvrir le PDF"
                            style="-fx-background-color: #aebce1; -fx-text-fill: black; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 0;"/>
                    <Button fx:id="btnModifier" onAction="#modifierDocument" maxWidth="Infinity" text="✏️ Modifier"
                            style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 0;"/>
                    <Button fx:id="btnChanger" onAction="#changerStatut" maxWidth="Infinity" text="🔄 Changer le statut"
                            style="-fx-background-color: #5584D5; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 0;"/>
                    <Button fx:id="btnSupprimer" onAction="#supprimerDocument" maxWidth="Infinity" text="🗑️ Supprimer"
                            style="-fx-background-color: #E81123; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 0;"/>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>