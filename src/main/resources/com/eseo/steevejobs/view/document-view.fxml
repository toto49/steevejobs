<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="720.0" prefWidth="1280.0"
            style="-fx-background-color: #f4f5f7;" xmlns="http://javafx.com/javafx/11"
            fx:controller="com.eseo.steevejobs.controller.DocumentController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0"
              style="-fx-background-color: #6a8bce;">
            <padding><Insets left="20.0" right="20.0"/></padding>
            <Label text="&lt; GESTION COMMERCIALE" textFill="WHITE">
                <font><Font name="System Bold" size="24.0"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnNouveauDoc" onAction="#ouvrirFormulaireCreation"
                    text="+ Nouveau document"
                    style="-fx-background-color: white; -fx-text-fill: #4B78CC;
                           -fx-font-weight: bold; -fx-background-radius: 15;
                           -fx-cursor: hand; -fx-padding: 6 14;"/>
            <padding><Insets right="20.0"/></padding>
        </HBox>
    </top>

    <center>
        <HBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <!-- LISTE DES DOCUMENTS -->
            <VBox HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-border-color: #d1d5db; -fx-border-radius: 10;">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>

                <!-- Filtres -->
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15.0">
                    <TextField fx:id="searchField"
                               promptText="Rechercher un client..."
                               prefWidth="250.0"
                               onKeyReleased="#filtrer"
                               style="-fx-background-radius: 15; -fx-background-color: #e5e7eb;"/>
                    <ComboBox fx:id="comboTypeFiltre"
                              promptText="Tous les types"
                              prefWidth="180.0"
                              onAction="#filtrer"
                              style="-fx-background-radius: 15; -fx-background-color: #e5e7eb;"/>
                    <ComboBox fx:id="comboStatutFiltre"
                              promptText="Tous les statuts"
                              prefWidth="180.0"
                              onAction="#filtrer"
                              style="-fx-background-radius: 15; -fx-background-color: #e5e7eb;"/>
                </HBox>

                <TableView fx:id="tableDocuments" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colType"    text="Type"     prefWidth="140.0"/>
                        <TableColumn fx:id="colClient"  text="Client"   prefWidth="220.0"/>
                        <TableColumn fx:id="colDate"    text="Date"     prefWidth="120.0"/>
                        <TableColumn fx:id="colHT"      text="HT"       prefWidth="110.0"/>
                        <TableColumn fx:id="colTTC"     text="TTC"      prefWidth="110.0"/>
                        <TableColumn fx:id="colStatut"  text="Statut"   prefWidth="120.0"/>
                        <TableColumn fx:id="colActions" text=""         prefWidth="100.0"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucun document trouvé." style="-fx-text-fill: #9ca3af;"/>
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="20.0">
                    <Label fx:id="lblNbDocs" text="0 document(s)" textFill="#6b7280"/>
                </HBox>
            </VBox>

            <!-- PANNEAU DÉTAIL -->
            <VBox prefWidth="350.0"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-border-color: #d1d5db; -fx-border-radius: 10;">

                <VBox alignment="CENTER_LEFT" prefHeight="80.0"
                      style="-fx-background-color: #aebce1; -fx-background-radius: 10 10 0 0;">
                    <padding><Insets left="20.0" top="20.0"/></padding>
                    <Label text="Détail document" style="-fx-text-fill: black;">
                        <font><Font size="20.0"/></font>
                    </Label>
                </VBox>

                <VBox spacing="12.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                    </padding>

                    <Label fx:id="detailType"   text="" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label fx:id="detailClient" text="" textFill="#4b5563"/>

                    <Separator/>

                    <Label text="Informations" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

                    <GridPane vgap="10.0" hgap="10.0">
                        <Label text="Date"    textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="detailDate"   text="" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Total HT"  textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="detailHT"     text="" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Total TTC" textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="detailTTC"    text="" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Statut"    textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Label fx:id="detailStatut" text="" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    </GridPane>

                    <Separator/>

                    <Label text="Lignes produits" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <VBox fx:id="lignesContainer" spacing="8.0"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button fx:id="btnOuvrirPdf" onAction="#ouvrirPdf"
                            maxWidth="Infinity"
                            text="📄 Ouvrir le PDF"
                            style="-fx-background-color: #aebce1; -fx-background-radius: 8;
                                   -fx-cursor: hand; -fx-padding: 8 0;"/>
                    <Button fx:id="btnChanger" onAction="#changerStatut"
                            maxWidth="Infinity"
                            text="Changer le statut"
                            style="-fx-background-color: #5584D5; -fx-text-fill: white;
                                   -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 0;"/>
                    <Button fx:id="btnSupprimer" onAction="#supprimerDocument"
                            maxWidth="Infinity"
                            text="Supprimer"
                            style="-fx-background-color: #E81123; -fx-text-fill: white;
                                   -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 0;"/>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
