<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="720.0" prefWidth="1280.0"
            style="-fx-background-color: #DDE8FF;" stylesheets="@../../../../style/style.css"
            xmlns="http://javafx.com/javafx/21" fx:controller="com.eseo.steevejobs.controller.AdminUserController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0"
              style="-fx-background-color: #7A9FE0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets left="40.0" right="40.0"/>
            </padding>
            <children>
                <Label fx:id="headerTitle"
                       style="-fx-font-size: 28px; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                       text="UTILISATEURS"/>
            </children>
        </HBox>
    </top>

    <center>
        <HBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
            </padding>

            <VBox spacing="15.0"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d1d5db; -fx-border-radius: 8;"
                  HBox.hgrow="ALWAYS">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>

                <HBox alignment="CENTER_RIGHT" prefHeight="45.0" spacing="15.0">
                    <TextField fx:id="searchField" prefHeight="38.0" prefWidth="300.0"
                               promptText="🔍 Rechercher un utilisateur..."
                               style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d1d5db; -fx-background-color: #f9fafb; -fx-font-size: 14px;"/>
                    <Button fx:id="addUserBtn" mnemonicParsing="false" onAction="#CreateUser" prefHeight="38.0"
                            style="-fx-background-color: #7A9FE0; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"
                            text="+ Nouvel Utilisateur">
                        <font>
                            <Font name="System Bold" size="14.0"/>
                        </font>
                        <padding>
                            <Insets left="15.0" right="15.0"/>
                        </padding>
                    </Button>
                </HBox>

                <TableView fx:id="userTable" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName" prefWidth="250.0" text="Nom Complet"/>
                        <TableColumn fx:id="colJob" prefWidth="200.0" text="Poste / Métier"/>
                        <TableColumn fx:id="colRole" prefWidth="150.0" text="Rôle"/>
                        <TableColumn fx:id="colStatus" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Statut"/>
                        <TableColumn fx:id="colActions" prefWidth="50.0"
                                     style="-fx-alignment: CENTER; -fx-text-fill: black" text="⋮"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="20.0">
                    <Label fx:id="paginationInfoLabel" text="0 employé(s) trouvé(s)" textFill="#6b7280">
                        <font>
                            <Font name="System Italic" size="13.0"/>
                        </font>
                    </Label>
                    <Pagination fx:id="pagination" maxPageIndicatorCount="5" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <VBox prefWidth="380.0"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d1d5db; -fx-border-radius: 8;">

                <VBox alignment="CENTER_LEFT" prefHeight="70.0"
                      style="-fx-background-color: #f8fafc; -fx-background-radius: 8 8 0 0; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets left="25.0" right="25.0"/>
                    </padding>
                    <Label fx:id="detailsHeaderTitle" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"
                           text="Détails du Profil">
                        <font>
                            <Font size="20.0"/>
                        </font>
                    </Label>
                </VBox>

                <ScrollPane fitToWidth="true"
                            style="-fx-background: white; -fx-background-color: transparent; -fx-border-color: transparent;"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="18.0">
                            <padding>
                                <Insets bottom="30.0" left="25.0" right="25.0" top="25.0"/>
                            </padding>

                            <VBox spacing="2.0">
                                <Label fx:id="detailsName"
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                                       text="Sélectionnez un utilisateur" wrapText="true"/>
                                <Label fx:id="detailsJob" style="-fx-font-size: 14px;" text="-" textFill="#6b7280"/>
                            </VBox>

                            <Separator/>

                            <VBox spacing="12.0">
                                <Label fx:id="personalInfoHeader"
                                       style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #7A9FE0;"
                                       text="Informations Personnelles"/>

                                <GridPane hgap="10.0" vgap="12.0">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="65.0" prefWidth="65.0"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                                    </rowConstraints>

                                    <Label fx:id="lblEmail" text="E-mail :" textFill="#6b7280" GridPane.columnIndex="0"
                                           GridPane.rowIndex="0"/>
                                    <Label fx:id="detailsEmailVal" style="-fx-text-fill: #2c3e50;" text="-"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                    <Label fx:id="lblPhone" text="Tél :" textFill="#6b7280" GridPane.columnIndex="0"
                                           GridPane.rowIndex="1"/>
                                    <Label fx:id="detailsPhoneVal" style="-fx-text-fill: #2c3e50;" text="-"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                    <Label fx:id="lblAddress" text="Adresse :" textFill="#6b7280"
                                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                    <Label fx:id="detailsAddressVal" style="-fx-text-fill: #2c3e50;" text="-"
                                           wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                </GridPane>
                            </VBox>

                            <Separator/>

                            <VBox spacing="12.0">
                                <Label fx:id="eventsHeader"
                                       style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #7A9FE0;"
                                       text="Prochains Événements"/>
                                <VBox fx:id="eventsContainer" spacing="10.0"/>
                            </VBox>

                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>
        </HBox>
    </center>
</BorderPane>