<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="700.0" prefWidth="900.0" stylesheets="@/style/style.css"
            style="-fx-background-color: #f4f5f7;"
            fx:controller="com.eseo.steevejobs.controller.ModifierDocumentController">

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #f4f5f7;">
            <VBox spacing="15.0">
                <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>

                <!-- Informations document -->
                <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10;">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></padding>
                    <Label text="Informations document" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #4B78CC;"/>

                    <GridPane hgap="15.0" vgap="12.0">
                        <Label text="Type :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <ComboBox fx:id="comboType" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Client :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <ComboBox fx:id="comboTiers" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Date :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <DatePicker fx:id="datePicker" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                    style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5;"/>

                        <Label text="Statut :" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <ComboBox fx:id="comboStatut" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    </GridPane>
                </VBox>

                <!-- Lignes produits -->
                <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10;">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></padding>
                    <Label text="Lignes produits" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #4B78CC;"/>

                    <GridPane hgap="15.0" vgap="10.0">
                        <Label text="Produit :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <ComboBox fx:id="comboProduit" prefWidth="350.0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Quantité :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <TextField fx:id="txtQuantite" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Prix vente HT :" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <TextField fx:id="txtPrixVente" prefWidth="150.0" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <Button fx:id="btnAjouterLigne" text="+ Ajouter" onAction="#ajouterLigne"
                                style="-fx-background-color: #4B78CC; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"
                                GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    </GridPane>

                    <TableView fx:id="tableLignes" prefHeight="200.0">
                        <columns>
                            <TableColumn fx:id="colProduit" text="Produit" prefWidth="300.0"/>
                            <TableColumn fx:id="colQuantite" text="Qté" prefWidth="80.0"/>
                            <TableColumn fx:id="colPrixUnitaire" text="Prix HT" prefWidth="100.0"/>
                            <TableColumn fx:id="colTotalLigne" text="Total HT" prefWidth="100.0"/>
                            <TableColumn fx:id="colActions" text="" prefWidth="50.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" spacing="20.0">
                        <Label text="Total HT :" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <Label fx:id="lblTotalHT" text="0,00 €" style="-fx-text-fill: #4B78CC; -fx-font-weight: bold;"/>
                        <Label text="TVA (20%) :" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <Label fx:id="lblTVA" text="0,00 €" style="-fx-text-fill: #333333;"/>
                        <Label text="Total TTC :" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <Label fx:id="lblTotalTTC" text="0,00 €" style="-fx-text-fill: #E81123; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <Button fx:id="btnAnnuler" onAction="#fermer" text="Annuler"
                            style="-fx-background-color: #e5e7eb; -fx-text-fill: #333333; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8 20;"/>
                    <Button fx:id="btnModifier" onAction="#modifierDocument" text="Modifier"
                            style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 8 20;"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>