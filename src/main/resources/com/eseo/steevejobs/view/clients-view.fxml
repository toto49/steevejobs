<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="720.0" prefWidth="1280.0" stylesheets="@/style/style.css"
            style="-fx-background-color: #f4f5f7;" xmlns="http://javafx.com/javafx/11"
            fx:controller="com.eseo.steevejobs.controller.ClientsController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #4B78CC;">
            <padding><Insets left="20.0" right="20.0"/></padding>
            <Label text="GESTION DES CLIENTS" textFill="WHITE">
                <font><Font name="System Bold" size="24.0"/></font>
            </Label>
        </HBox>
    </top>

    <center>
        <HBox spacing="15.0">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>

            <!-- LISTE DES CLIENTS -->
            <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></padding>

                <!-- FILTRES -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <TextField fx:id="searchField" promptText="Rechercher un client..." prefWidth="250.0" prefHeight="50.0"
                               onKeyReleased="#filtrer" style="-fx-background-radius: 20; -fx-padding: 8 12;"/>
                    <ComboBox fx:id="comboTypeFiltre" promptText="Tous les types" prefWidth="180.0" prefHeight="50.0"
                              onAction="#filtrer" style="-fx-background-radius: 20;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnNouveauClient" onAction="#ouvrirFormulaireCreation"
                            text="+ Nouveau client" prefWidth="220.0" prefHeight="50.0"
                            style="-fx-background-color: white; -fx-text-fill: #4B78CC;
                                   -fx-font-weight: bold; -fx-border-color: #d1d5db;
                                   -fx-border-radius: 20; -fx-background-radius: 20;
                                   -fx-cursor: hand; -fx-padding: 8 16;"/>
                </HBox>

                <!-- ESPACE ENTRE FILTRES ET TABLEAU -->
                <VBox prefHeight="20.0" minHeight="20.0">
                    <padding><Insets top="15.0" bottom="5.0"/></padding>
                </VBox>

                <!-- TABLEAU -->
                <TableView fx:id="tableClients" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colType" text="TYPE" prefWidth="100.0"/>
                        <TableColumn fx:id="colNom" text="NOM" prefWidth="200.0"/>
                        <TableColumn fx:id="colPrenom" text="PRÉNOM" prefWidth="150.0"/>
                        <TableColumn fx:id="colEmail" text="EMAIL" prefWidth="220.0"/>
                        <TableColumn fx:id="colTel" text="TÉLÉPHONE" prefWidth="150.0"/>
                        <TableColumn fx:id="colSiret" text="SIRET" prefWidth="150.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="📄 Aucun client trouvé" style="-fx-text-fill: #9ca3af; -fx-font-size: 14px;"/>
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_LEFT" prefHeight="40.0">
                    <Label fx:id="lblNbClients" text="0 client(s)" textFill="#6b7280" style="-fx-font-size: 12px;"/>
                </HBox>
            </VBox>

            <!-- PANNEAU DÉTAIL -->
            <VBox prefWidth="380.0" style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <VBox alignment="CENTER_LEFT" prefHeight="60.0" minHeight="60.0" style="-fx-background-color: #aebce1; -fx-background-radius: 10 10 0 0;">
                    <padding><Insets left="20.0" top="15.0" bottom="15.0"/></padding>
                    <Label text="DETAILS" style="-fx-text-fill: black; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="12.0">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="15.0"/></padding>

                    <Label text="INFORMATIONS SPECIFIQUES" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #4B78CC;"/>

                    <GridPane vgap="8.0" hgap="10.0">
                        <Label text="Nom :" textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="detailNom" textFill="#333333" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Prénom :" textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="detailPrenom" textFill="#333333" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Type :" textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="detailType" textFill="#333333" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Email :" textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Label fx:id="detailEmail" textFill="#333333" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="Téléphone :" textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <Label fx:id="detailTel" textFill="#333333" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                        <Label text="Adresse :" textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                        <Label fx:id="detailAdresse" textFill="#333333" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                        <Label text="SIRET :" textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                        <Label fx:id="detailSiret" textFill="#333333" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                        <Label text="N° TVA :" textFill="#6b7280" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                        <Label fx:id="detailNumTva" textFill="#333333" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                    </GridPane>

                    <Separator/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button fx:id="btnModifier" onAction="#modifierClient" maxWidth="Infinity" text="✏️ Modifier"
                            style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 0;"/>
                    <Button fx:id="btnSupprimer" onAction="#supprimerClient" maxWidth="Infinity" text="🗑️ Supprimer"
                            style="-fx-background-color: #E81123; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 0;"/>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>