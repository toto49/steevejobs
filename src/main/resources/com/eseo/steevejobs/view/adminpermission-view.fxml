<?xml version="1.0" encoding="UTF-8"?>

<!--
    Écran d'administration des permissions
    - Layout principal : BorderPane
    - Controller : AdminPermissionController
    - Style global : fond bleu clair + CSS externe
-->
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/21"
            prefHeight="600.0" prefWidth="800.0"
            fx:controller="com.eseo.steevejobs.controller.AdminPermissionController"
            style="-fx-background-color: #DDE8FF;"
            stylesheets="@../../../../style/style.css">

    <!-- =======================
         BARRE SUPÉRIEURE (HEADER)
         ======================= -->
    <top>
        <VBox>
            <children>

                <!-- Bandeau bleu avec le titre -->
                <HBox alignment="CENTER_LEFT" prefHeight="60" style="-fx-background-color: #4B78CC;">
                    <padding>
                        <Insets left="20" right="20"/>
                    </padding>

                    <!-- Titre principal -->
                    <Label text="GESTIONS PERMISSIONS" textFill="WHITE">
                        <font>
                            <Font name="System Bold" size="24"/>
                        </font>
                    </Label>
                </HBox>

            </children>
        </VBox>
    </top>

    <!-- =======================
         CONTENU CENTRAL
         ======================= -->
    <center>
        <VBox spacing="20" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="30" bottom="30" left="40" right="40"/>
            </padding>

            <children>

                <!-- Carte blanche contenant la configuration -->
                <VBox spacing="20"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d1d5db;"
                      VBox.vgrow="ALWAYS">

                    <padding>
                        <Insets top="25" bottom="25" left="30" right="30"/>
                    </padding>

                    <children>

                        <!-- Section titre + description -->
                        <VBox spacing="5">
                            <children>

                                <!-- Sous-titre -->
                                <Label text="Configuration des accès"
                                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                                <!-- Texte explicatif -->
                                <Label text="Sélectionnez un rôle ci-dessous pour modifier ses accès en temps réel."
                                       style="-fx-text-fill: #6b7280;">
                                    <font>
                                        <Font name="System Italic" size="14"/>
                                    </font>
                                </Label>

                            </children>
                        </VBox>

                        <!-- ComboBox pour choisir le rôle -->
                        <ComboBox fx:id="roleComboBox"
                                  prefHeight="40" prefWidth="300"
                                  promptText="Choisir un rôle..."
                                  styleClass="combo-box"
                                  style="-fx-font-size: 14px; -fx-background-radius: 5;"/>

                        <!-- Séparateur visuel -->
                        <Separator prefWidth="200">
                            <VBox.margin>
                                <Insets top="10" bottom="10"/>
                            </VBox.margin>
                        </Separator>

                        <!-- Titre de la section permissions -->
                        <Label text="Permissions Actives"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #7A9FE0;"/>

                        <!-- ScrollPane contenant les permissions dynamiques -->
                        <ScrollPane fitToWidth="true"
                                    style="-fx-background-color: transparent; -fx-background: transparent;"
                                    VBox.vgrow="ALWAYS">

                            <content>

                                <!-- Conteneur où les ToggleButtons seront injectés -->
                                <VBox fx:id="permissionsContainer"
                                      spacing="12"
                                      style="-fx-background-color: white;">
                                    <padding>
                                        <Insets top="5" bottom="5" left="5" right="5"/>
                                    </padding>
                                </VBox>

                            </content>
                        </ScrollPane>

                    </children>
                </VBox>

            </children>
        </VBox>
    </center>

</BorderPane>
