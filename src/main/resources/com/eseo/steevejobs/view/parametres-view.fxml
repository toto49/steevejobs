<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17.0.12"
            prefHeight="768.0" prefWidth="1024.0"
            fx:controller="com.eseo.steevejobs.controller.ParametresController"
            style="-fx-background-color: #DDE8FF;"
            styleClass="root-pane"
            stylesheets="@../../../../style/style.css">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #4B78CC;">
            <padding>
                <Insets left="20" right="20"/>
            </padding>
            <Label fx:id="titlepageticket" text="PARAMÈTRES" style="-fx-text-fill: white;">
                <font>
                    <Font name="System Bold" size="24"/>
                </font>
            </Label>
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <VBox style="-fx-background-color: #DDE8FF;" BorderPane.alignment="CENTER">
            <children>

                <ScrollPane fitToWidth="true" fitToHeight="true"
                            style="-fx-background-color: transparent; -fx-background: #DDE8FF;"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox alignment="TOP_CENTER" style="-fx-background-color: transparent;">
                            <padding>
                                <Insets top="40" bottom="40" left="20" right="20"/>
                            </padding>

                            <children>
                                <GridPane hgap="40" vgap="30" maxWidth="1100">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="300" percentWidth="50"/>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="300" percentWidth="50"/>
                                    </columnConstraints>

                                    <rowConstraints>
                                        <RowConstraints minHeight="10" vgrow="ALWAYS"/>
                                    </rowConstraints>

                                    <children>

                                        <!-- COLONNE GAUCHE -->
                                        <VBox spacing="30" GridPane.columnIndex="0">
                                            <children>

                                                <!-- PRÉFÉRENCES -->
                                                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 10;"
                                                      styleClass="card">
                                                    <padding>
                                                        <Insets top="20" bottom="20" left="20" right="20"/>
                                                    </padding>

                                                    <children>
                                                        <Label text="PRÉFÉRENCES"
                                                               style="-fx-font-size: 20px; -fx-text-fill: black; -fx-font-weight: bold;">
                                                            <padding>
                                                                <Insets bottom="15"/>
                                                            </padding>
                                                        </Label>

                                                        <VBox spacing="15">
                                                            <padding>
                                                                <Insets top="10" bottom="20"/>
                                                            </padding>
                                                            <children>

                                                                <HBox alignment="CENTER_LEFT" spacing="20">
                                                                    <children>
                                                                        <Label text="SAUVEGARDER MAIL :"
                                                                               style="-fx-text-fill: black;"/>
                                                                        <CheckBox fx:id="ConnexionCheck"
                                                                                  mnemonicParsing="false"
                                                                                  onAction="#toggleConnexionSave"/>
                                                                    </children>
                                                                </HBox>

                                                                <HBox alignment="CENTER_LEFT" spacing="20">
                                                                    <children>
                                                                        <Label text="NOTIFICATIONS PUSH :"
                                                                               style="-fx-text-fill: black;"/>
                                                                        <CheckBox fx:id="pushNotificationsToggle"
                                                                                  mnemonicParsing="false"
                                                                                  onAction="#togglePushNotification"/>
                                                                    </children>
                                                                </HBox>

                                                            </children>
                                                        </VBox>

                                                        <Button text="TESTER LES NOTIFICATIONS PUSH"
                                                                onAction="#testpush"
                                                                alignment="CENTER"
                                                                maxWidth="Infinity"
                                                                style="-fx-background-color: #5584D5; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 0; -fx-cursor: hand;"/>
                                                    </children>
                                                </VBox>

                                                <!-- SÉCURITÉ -->
                                                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 10;"
                                                      styleClass="card">
                                                    <padding>
                                                        <Insets top="20" bottom="20" left="20" right="20"/>
                                                    </padding>

                                                    <children>
                                                        <Label text="SÉCURITÉ"
                                                               style="-fx-font-size: 20px; -fx-text-fill: black; -fx-font-weight: bold;">
                                                            <padding>
                                                                <Insets bottom="15"/>
                                                            </padding>
                                                        </Label>

                                                        <GridPane vgap="15">
                                                            <columnConstraints>
                                                                <ColumnConstraints prefWidth="180" minWidth="10"
                                                                                   maxWidth="200"/>
                                                                <ColumnConstraints prefWidth="200" minWidth="10"
                                                                                   hgrow="ALWAYS"/>
                                                            </columnConstraints>

                                                            <rowConstraints>
                                                                <RowConstraints prefHeight="30"/>
                                                                <RowConstraints prefHeight="30"/>
                                                                <RowConstraints prefHeight="30"/>
                                                            </rowConstraints>

                                                            <children>
                                                                <Label text="ANCIEN MOT DE PASSE :"
                                                                       style="-fx-text-fill: black;"/>
                                                                <PasswordField fx:id="ancienMdpField"
                                                                               GridPane.columnIndex="1"
                                                                               styleClass="champform"/>

                                                                <Label text="NOUVEAU MOT DE PASSE :"
                                                                       GridPane.rowIndex="1"
                                                                       style="-fx-text-fill: black;"/>
                                                                <PasswordField fx:id="nouveauMdpField"
                                                                               GridPane.columnIndex="1"
                                                                               GridPane.rowIndex="1"
                                                                               styleClass="champform"/>

                                                                <Label text="CONFIRMER NOUVEAU MDP :"
                                                                       GridPane.rowIndex="2"
                                                                       style="-fx-text-fill: black;"/>
                                                                <PasswordField fx:id="confirmerMdpField"
                                                                               GridPane.columnIndex="1"
                                                                               GridPane.rowIndex="2"
                                                                               styleClass="champform"/>
                                                            </children>
                                                        </GridPane>

                                                        <HBox alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                                                            <children>
                                                                <Button text="VALIDER"
                                                                        onAction="#validerSecurite"
                                                                        style="-fx-background-color: #5584D5; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 30; -fx-cursor: hand;"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>

                                                <!-- DÉCONNEXION -->
                                                <Button text="Déconnexion"
                                                        onAction="#resetsession"
                                                        maxWidth="Infinity"
                                                        style="-fx-background-color: #E81123; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;"/>

                                            </children>
                                        </VBox>

                                        <!-- COLONNE DROITE -->
                                        <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 10;"
                                              styleClass="card"
                                              GridPane.columnIndex="1"
                                              GridPane.valignment="TOP">
                                            <padding>
                                                <Insets top="20" bottom="20" left="20" right="20"/>
                                            </padding>

                                            <children>
                                                <Label text="MES INFORMATIONS"
                                                       style="-fx-font-size: 20px; -fx-text-fill: black; -fx-font-weight: bold;">
                                                    <padding>
                                                        <Insets bottom="20"/>
                                                    </padding>
                                                </Label>

                                                <GridPane hgap="10" vgap="25" VBox.vgrow="ALWAYS">
                                                    <columnConstraints>
                                                        <ColumnConstraints prefWidth="80" minWidth="60"/>
                                                        <ColumnConstraints prefWidth="200" minWidth="10"
                                                                           hgrow="ALWAYS"/>
                                                    </columnConstraints>

                                                    <rowConstraints>
                                                        <RowConstraints prefHeight="30"/>
                                                        <RowConstraints prefHeight="30"/>
                                                        <RowConstraints prefHeight="30"/>
                                                        <RowConstraints prefHeight="30"/>
                                                    </rowConstraints>

                                                    <children>
                                                        <Label text="MAIL :" style="-fx-text-fill: black;"/>
                                                        <TextField fx:id="mailField"
                                                                   GridPane.columnIndex="1"
                                                                   styleClass="champform"/>

                                                        <Label text="TEL :" GridPane.rowIndex="1"
                                                               style="-fx-text-fill: black;"/>
                                                        <TextField fx:id="telField"
                                                                   GridPane.columnIndex="1"
                                                                   GridPane.rowIndex="1"
                                                                   styleClass="champform"/>
                                                        <Label text="ADRESSE :" GridPane.rowIndex="2"
                                                               style="-fx-text-fill: black;"/>
                                                        <TextField fx:id="adresseField"
                                                                   GridPane.columnIndex="1"
                                                                   GridPane.rowIndex="2"
                                                                   styleClass="champform"/>

                                                        <Label text="NOM :" GridPane.rowIndex="3"
                                                               style="-fx-text-fill: black;"/>
                                                        <TextField fx:id="nomField"
                                                                   GridPane.columnIndex="1"
                                                                   GridPane.rowIndex="3"
                                                                   styleClass="champform"/>

                                                        <Label text="PRÉNOM :" GridPane.rowIndex="4"
                                                               style="-fx-text-fill: black;"/>
                                                        <TextField fx:id="prenomField"
                                                                   GridPane.columnIndex="1"
                                                                   GridPane.rowIndex="4"
                                                                   styleClass="champform"/>
                                                    </children>
                                                </GridPane>

                                                <HBox alignment="BOTTOM_CENTER" style="-fx-padding: 40 0 0 0;"
                                                      VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <Button text="ENREGISTRER LES MODIFICATIONS"
                                                                onAction="#enregistrerInformations"
                                                                maxWidth="Infinity"
                                                                style="-fx-background-color: #5584D5; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                    </children>
                                </GridPane>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </center>

</BorderPane>
