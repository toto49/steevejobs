<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:id="mainPane"
            xmlns="http://javafx.com/javafx"
            fx:controller="com.eseo.steevejobs.controller.MenuController"
            prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #2b2b2b;">

    <left>
        <VBox spacing="10"
              alignment="TOP_CENTER"
              prefWidth="100.0"
              style="-fx-background-color: #4B78CC; -fx-border-color: #4B78CC; -fx-border-width: 0 2 0 0; -fx-padding: 0 0 20 0;">

            <Region prefHeight="10"/>

            <Button style="-fx-background-color: transparent; -fx-cursor: hand;">
                <graphic>
                    <ImageView fx:id="myImageView" fitHeight="60.0" fitWidth="60.0" pickOnBounds="true"
                               preserveRatio="true">
                        <image>
                            <Image url="@../../../../images/logo.png"/>
                        </image>
                        <clip>
                            <Circle centerX="30" centerY="30" radius="30"/>
                        </clip>
                    </ImageView>
                </graphic>
            </Button>

            <Region prefHeight="20"/>

            <Button fx:id="btnAccueil"
                    onAction="#afficherAccueil"
                    prefWidth="180"
                    prefHeight="60"
