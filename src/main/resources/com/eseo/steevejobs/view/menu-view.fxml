                                scaleX="1.3"
                                scaleY="1.3"/>
                    </Group>
                </graphic>
            </Button>

            <Region prefHeight="20"/>

            <Button fx:id="btnFiles"
                    onAction="#afficherFiles"
                    prefWidth="180"
                    prefHeight="60"
