<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f4f5f7;" stylesheets="@/style/date_picker.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eseo.steevejobs.controller.CalendrierController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #6a8bce;" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="20.0" />
            </padding>
            <Label fx:id="headerTitle" text="&lt; CALENDRIER" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f4f5f7; -fx-border-color: transparent;">
            <content>
                <VBox>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>

                    <children>
                        <VBox style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 2; -fx-border-radius: 15; -fx-background-radius: 15;">
                            <children>

                                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 10 20 10 20; -fx-border-color: #bdc3c7; -fx-border-width: 0 0 1 0;">
                                    <children>
                                        <Label fx:id="labelSemaine" text="Semaine..." textFill="BLACK">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <DatePicker fx:id="datePickerSemaine" prefHeight="35" styleClass="date-picker-custom" />
                                        <Button onAction="#lastWeek" prefHeight="35" prefWidth="100" style="-fx-cursor: hand; -fx-background-color: #6a8bce; -fx-text-fill: white; -fx-background-radius: 5;" text="◀ Précédent" />
                                        <Button onAction="#nextWeek" prefHeight="35" prefWidth="100" style="-fx-cursor: hand; -fx-background-color: #6a8bce; -fx-text-fill: white; -fx-background-radius: 5;" text="Suivant ▶" />
                                        <Button onAction="#ouvrirPopupAjout" prefHeight="35" style="-fx-cursor: hand; -fx-background-color: #6a8bce; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" text="Nouvel Événement" />
                                        <HBox spacing="10.0" />
                                    </children>
                                </HBox>

                                <GridPane fx:id="gridPlanning" gridLinesVisible="true" style="-fx-background-color: transparent;">
                                    <VBox.margin>
                                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                    </VBox.margin>

                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="30.0" prefWidth="30.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                                    </columnConstraints>

                                    <rowConstraints>
                                        <RowConstraints minHeight="60.0" prefHeight="70.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                    </rowConstraints>

                                    <children>
                                        <Pane style="-fx-background-color: transparent;" />

                                        <VBox alignment="CENTER" spacing="5.0" GridPane.columnIndex="1">
                                            <Label fx:id="lundiLabel" text="LUNDI" textFill="BLACK" />
                                            <Button fx:id="lundiHeuresBtn" onAction="#ouvrirPopupHeures" userData="0" text="MES HEURES" />
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="5.0" GridPane.columnIndex="2">
                                            <Label fx:id="mardiLabel" text="MARDI" textFill="BLACK" />
                                            <Button fx:id="mardiHeuresBtn" onAction="#ouvrirPopupHeures" userData="1" text="MES HEURES" />
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="5.0" GridPane.columnIndex="3">
                                            <Label fx:id="mercrediLabel" text="MERCREDI" textFill="BLACK" />
                                            <Button fx:id="mercrediHeuresBtn" onAction="#ouvrirPopupHeures" userData="2" text="MES HEURES" />
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="5.0" GridPane.columnIndex="4">
                                            <Label fx:id="jeudiLabel" text="JEUDI" textFill="BLACK" />
                                            <Button fx:id="jeudiHeuresBtn" onAction="#ouvrirPopupHeures" userData="3" text="MES HEURES" />
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="5.0" GridPane.columnIndex="5">
                                            <Label fx:id="vendrediLabel" text="VENDREDI" textFill="BLACK" />
                                            <Button fx:id="vendrediHeuresBtn" onAction="#ouvrirPopupHeures" userData="4" text="MES HEURES" />
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="5.0" GridPane.columnIndex="6">
                                            <Label fx:id="samediLabel" text="SAMEDI" textFill="BLACK" />
                                            <Button fx:id="samediHeuresBtn" onAction="#ouvrirPopupHeures" userData="5" text="MES HEURES" />
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="5.0" GridPane.columnIndex="7">
                                            <Label fx:id="dimancheLabel" text="DIMANCHE" textFill="BLACK" />
                                            <Button fx:id="dimancheHeuresBtn" onAction="#ouvrirPopupHeures" userData="6" text="MES HEURES" />
                                        </VBox>

                                        <Label text="6 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
                                        <Label text="7 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
                                        <Label text="8 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
                                        <Label text="9 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="4" />
                                        <Label text="10 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="5" />
                                        <Label text="11 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="6" />
                                        <Label text="12 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="7" />
                                        <Label text="13 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="8" />
                                        <Label text="14 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="9" />
                                        <Label text="15 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="10" />
                                        <Label text="16 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="11" />
                                        <Label text="17 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="12" />
                                        <Label text="18 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="13" />
                                        <Label text="19 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="14" />
                                        <Label text="20 : 00" textFill="BLACK" GridPane.halignment="CENTER" GridPane.rowIndex="15" />

                                    </children>
                                </GridPane>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>