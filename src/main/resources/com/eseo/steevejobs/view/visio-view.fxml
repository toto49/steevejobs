<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" prefHeight="768.0" prefWidth="944.0" spacing="0.0"
      style="-fx-background-color: #DDE8FF;" stylesheets="@../../../../style/style.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      fx:controller="com.eseo.steevejobs.controller.VisioController">

    <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: #7A9FE0;">
        <padding>
            <Insets left="40.0" right="40.0"/>
        </padding>
        <children>
            <Label text="VISIOCONFÉRENCE"
                   style="-fx-font-size: 28px; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button mnemonicParsing="false" onAction="#rafraichirListeReunions"
                    styleClass="visio-btn-header"
                    text="Actualiser"/>
        </children>
    </HBox>

    <VBox spacing="24.0" styleClass="visio-content" VBox.vgrow="ALWAYS">
        <children>

            <Label text="Rejoignez une réunion instantanée ou planifiez une visio avec votre équipe."
                   styleClass="visio-subtitle"/>

            <HBox spacing="24.0" VBox.vgrow="ALWAYS">
                <children>

                    <VBox minWidth="400.0" prefWidth="400.0" spacing="24.0">
                        <children>

                            <VBox spacing="16.0" styleClass="visio-card">
                                <children>
                                    <Label text="Rejoindre un salon" styleClass="visio-card-title"/>
                                    <Label text="Saisissez l'identifiant du salon pour lancer la visio dans votre navigateur."
                                           styleClass="visio-field-label" wrapText="true"/>
                                    <HBox spacing="12.0">
                                        <children>
                                            <TextField fx:id="txtRoomName"
                                                       promptText="Ex : reunion-equipe, cellule-crise..."
                                                       styleClass="visio-field" HBox.hgrow="ALWAYS"/>
                                            <Button fx:id="btnRejoindre" mnemonicParsing="false"
                                                    onAction="#demanderConnexion"
                                                    styleClass="visio-btn-primary" text="Rejoindre"/>
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                            <VBox spacing="16.0" styleClass="visio-card" VBox.vgrow="ALWAYS">
                                <children>
                                    <Label text="Programmer une réunion" styleClass="visio-card-title"/>

                                    <VBox spacing="8.0">
                                        <children>
                                            <Label text="Identifiant du salon" styleClass="visio-field-label"/>
                                            <TextField fx:id="txtPlanifRoomName" promptText="Nom unique de la salle"
                                                       styleClass="visio-field"/>
                                        </children>
                                    </VBox>

                                    <VBox spacing="8.0">
                                        <children>
                                            <Label text="Date" styleClass="visio-field-label"/>
                                            <DatePicker fx:id="datePlanif" maxWidth="1.7976931348623157E308"
                                                        prefHeight="38.0" promptText="jj/mm/aaaa"
                                                        styleClass="date-picker-custom"
                                                        stylesheets="@/style/popup.css"/>
                                        </children>
                                    </VBox>

                                    <HBox spacing="16.0">
                                        <children>
                                            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label text="Heure" styleClass="visio-field-label"/>
                                                    <Spinner fx:id="spinnerHeure" editable="true"
                                                             maxWidth="1.7976931348623157E308"
                                                             minWidth="130.0" prefHeight="38.0" prefWidth="130.0"
                                                             styleClass="visio-field"/>
                                                </children>
                                            </VBox>
                                            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label text="Min" styleClass="visio-field-label"/>
                                                    <Spinner fx:id="spinnerMinute" editable="true"
                                                             maxWidth="1.7976931348623157E308"
                                                             minWidth="130.0" prefHeight="38.0" prefWidth="130.0"
                                                             styleClass="visio-field"/>
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>

                                    <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                                        <children>
                                            <Label text="Invités (sélection multiple)" styleClass="visio-field-label"/>
                                            <ListView fx:id="listEmployesDisponibles" styleClass="visio-list"
                                                      VBox.vgrow="ALWAYS"/>
                                        </children>
                                    </VBox>

                                    <Button fx:id="btnPlanifier" maxWidth="1.7976931348623157E308"
                                            mnemonicParsing="false" onAction="#planifierReunion"
                                            styleClass="visio-btn-primary-wide"
                                            text="Enregistrer la planification"/>
                                </children>
                            </VBox>
                        </children>
                    </VBox>

                    <VBox spacing="16.0" styleClass="visio-card" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="Mes réunions" styleClass="visio-card-title"/>

                            <TableView fx:id="tableReunions" styleClass="visio-table" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colRoomName" prefWidth="250.0" text="Salon"/>
                                    <TableColumn fx:id="colStatut" prefWidth="130.0" text="État"/>
                                    <TableColumn fx:id="colDate" prefWidth="180.0" text="Date prévue"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <placeholder>
                                    <Label text="Aucune réunion programmée pour le moment."
                                           style="-fx-text-fill: #9CA3AF; -fx-font-size: 14px;"/>
                                </placeholder>
                            </TableView>

                            <HBox alignment="CENTER_RIGHT">
                                <children>
                                    <Button fx:id="btnRejoindreSelection" mnemonicParsing="false"
                                            onAction="#rejoindreSalonSelectionne"
                                            styleClass="visio-btn-primary"
                                            text="Rejoindre la sélection"/>
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" styleClass="visio-status-bar">
                <children>
                    <Label fx:id="lblStatut" text="Prêt." styleClass="visio-status-text"/>
                </children>
            </HBox>
        </children>
    </VBox>
</VBox>
