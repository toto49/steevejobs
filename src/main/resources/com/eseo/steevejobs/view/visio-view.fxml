<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" prefHeight="700.0" prefWidth="1000.0" spacing="20.0"
      style="-fx-background-color: #13131a;" xmlns="http://javafx.com/javafx/25"
      fx:controller="com.eseo.steevejobs.controller.VisioController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>
    <children>

        <VBox spacing="5.0">
            <children>
                <Label text="Espace Visioconférence Hub" textFill="WHITE">
                    <font>
                        <Font name="Segoe UI Bold" size="26.0"/>
                    </font>
                </Label>
                <Label text="Planifiez des réunions d'équipe sécurisées ou rejoignez un salon WebRTC instantané hébergé sur le NAS."
                       textFill="#8b8ba0">
                    <font>
                        <Font name="Segoe UI" size="13.0"/>
                    </font>
                </Label>
            </children>
        </VBox>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>

                <VBox prefWidth="380.0" spacing="20.0">
                    <children>

                        <VBox spacing="12.0"
                              style="-fx-background-color: #1c1c24; -fx-background-radius: 8; -fx-border-color: #2d2d3d; -fx-border-radius: 8;">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                            </padding>
                            <children>
                                <Label text="Rejoindre un salon rapide" textFill="WHITE">
                                    <font>
                                        <Font name="Segoe UI Bold" size="15.0"/>
                                    </font>
                                </Label>
                                <HBox spacing="10.0">
                                    <children>
                                        <TextField fx:id="txtRoomName" promptText="Ex: cellule-crise, 55s5s..."
                                                   style="-fx-background-color: #262632; -fx-text-fill: white; -fx-border-color: #3d3d52; -fx-border-radius: 4; -fx-background-radius: 4;"
                                                   HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font name="Segoe UI" size="13.0"/>
                                            </font>
                                        </TextField>
                                        <Button fx:id="btnRejoindre" mnemonicParsing="false"
                                                onAction="#demanderConnexion"
                                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"
                                                text="Démarrer">
                                            <font>
                                                <Font name="Segoe UI" size="13.0"/>
                                            </font>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="12.0"
                              style="-fx-background-color: #1c1c24; -fx-background-radius: 8; -fx-border-color: #2d2d3d; -fx-border-radius: 8;"
                              VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                            </padding>
                            <children>
                                <Label text="Programmer une réunion" textFill="WHITE">
                                    <font>
                                        <Font name="Segoe UI Bold" size="15.0"/>
                                    </font>
                                </Label>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="Identifiant du salon" textFill="#b3b3cc">
                                            <font>
                                                <Font name="Segoe UI" size="12.0"/>
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtPlanifRoomName" promptText="Nom unique de la pièce"
                                                   style="-fx-background-color: #262632; -fx-text-fill: white; -fx-border-color: #3d3d52; -fx-border-radius: 4; -fx-background-radius: 4;">
                                            <font>
                                                <Font name="Segoe UI" size="13.0"/>
                                            </font>
                                        </TextField>
                                    </children>
                                </VBox>

                                <HBox spacing="10.0">
                                    <children>
                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Date" textFill="#b3b3cc">
                                                    <font>
                                                        <Font name="Segoe UI" size="12.0"/>
                                                    </font>
                                                </Label>
                                                <DatePicker fx:id="datePlanif" maxWidth="1.7976931348623157E308"
                                                            style="-fx-control-inner-background: #262632; -fx-background-color: #262632; -fx-text-inner-color: white;"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="6.0" prefWidth="75.0">
                                            <children>
                                                <Label text="Heure" textFill="#b3b3cc">
                                                    <font>
                                                        <Font name="Segoe UI" size="12.0"/>
                                                    </font>
                                                </Label>
                                                <ComboBox fx:id="comboHeure" maxWidth="1.7976931348623157E308"
                                                          style="-fx-background-color: #262632; -fx-text-fill: white; -fx-border-color: #3d3d52; -fx-background-radius: 4; -fx-border-radius: 4;"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="6.0" prefWidth="75.0">
                                            <children>
                                                <Label text="Min" textFill="#b3b3cc">
                                                    <font>
                                                        <Font name="Segoe UI" size="12.0"/>
                                                    </font>
                                                </Label>
                                                <ComboBox fx:id="comboMinute" maxWidth="1.7976931348623157E308"
                                                          style="-fx-background-color: #262632; -fx-text-fill: white; -fx-border-color: #3d3d52; -fx-background-radius: 4; -fx-border-radius: 4;"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="Sélectionner les invités (Sélection multiple)" textFill="#b3b3cc">
                                            <font>
                                                <Font name="Segoe UI" size="12.0"/>
                                            </font>
                                        </Label>
                                        <ListView fx:id="listEmployesDisponibles"
                                                  style="-fx-background-color: #262632; -fx-border-color: #3d3d52; -fx-border-radius: 4; -fx-background-radius: 4; -fx-control-inner-background: #262632;"
                                                  VBox.vgrow="ALWAYS"/>
                                    </children>
                                </VBox>

                                <Button fx:id="btnPlanifier" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                                        onAction="#planifierReunion"
                                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 4;"
                                        text="📅 Enregistrer la planification">
                                    <font>
                                        <Font name="Segoe UI" size="13.0"/>
                                    </font>
                                    <padding>
                                        <Insets bottom="8.0" top="8.0"/>
                                    </padding>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <VBox spacing="15.0"
                      style="-fx-background-color: #1c1c24; -fx-background-radius: 8; -fx-border-color: #2d2d3d; -fx-border-radius: 8;"
                      HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Vos réunions programmées &amp; salons actifs" textFill="WHITE">
                                    <font>
                                        <Font name="Segoe UI Bold" size="15.0"/>
                                    </font>
                                </Label>
                                <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#rafraichirListeReunions"
                                                style="-fx-background-color: #262632; -fx-text-fill: #b3b3cc; -fx-border-color: #3d3d52; -fx-border-radius: 4; -fx-cursor: hand;"
                                                text="🔄 Actualiser"/>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <TableView fx:id="tableReunions"
                                   style="-fx-background-color: #1c1c24; -fx-border-color: #2d2d3d; -fx-background-radius: 4; -fx-border-radius: 4; -fx-control-inner-background: #1c1c24;"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colRoomName" prefWidth="250.0" text="Identifiant du Salon"/>
                                <TableColumn fx:id="colStatut" prefWidth="130.0" text="État"/>
                                <TableColumn fx:id="colDate" prefWidth="180.0" text="Date &amp; Heure Prévue"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT">
                            <children>
                                <Button fx:id="btnRejoindreSelection" mnemonicParsing="false"
                                        onAction="#rejoindreSalonSelectionne"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 4;"
                                        text="🔗 Rejoindre la session sélectionnée">
                                    <font>
                                        <Font name="Segoe UI" size="13.0"/>
                                    </font>
                                    <padding>
                                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
                                    </padding>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #13131a; -fx-border-color: #2d2d3d; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="10.0"/>
            </padding>
            <children>
                <Label fx:id="lblStatut" text="Status bar messages will appear here..." textFill="#8b8ba0">
                    <font>
                        <Font name="Segoe UI Italic" size="13.0"/>
                    </font>
                </Label>
            </children>
        </HBox>
    </children>
</VBox>