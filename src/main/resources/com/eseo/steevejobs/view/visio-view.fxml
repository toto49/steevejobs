<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml" alignment="CENTER" spacing="20.0" prefHeight="500.0"
      prefWidth="700.0" style="-fx-background-color: #121212;"
      xmlns="http://javafx.com/javafx" fx:controller="com.eseo.steevejobs.controller.VisioController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>
    <children>

        <Label text="Salles de Visioconférence Sécurisées"
               style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold;"/>

        <Label text="Entrez l'identifiant unique ou le nom du salon pour vous connecter en temps réel via WebRTC."
               style="-fx-text-fill: #aaaaaa; -fx-font-size: 14px;" wrapText="true" textAlignment="CENTER"/>

        <VBox alignment="CENTER" spacing="10.0" maxWidth="400.0">
            <children>
                <Label text="Identifiant du salon (Room ID) :" style="-fx-text-fill: #e0e0e0; -fx-font-size: 13px;"
                       alignment="CENTER_LEFT" maxWidth="Infinity"/>
                <TextField fx:id="txtRoomName" promptText="Ex: Salle_De_Crise, Equipe_Dev, RH_Entretien..."
                           style="-fx-background-color: #1e1e1e; -fx-text-fill: white; -fx-border-color: #3a3a3a; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;"/>
            </children>
        </VBox>

        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button fx:id="btnRejoindre" onAction="#demanderConnexion" text="🚀 Rejoindre / Créer le Salon"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25 12 25; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </children>
        </HBox>

        <Label fx:id="lblStatut" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 13px;"/>

    </children>
</VBox>