<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="com.eseo.steevejobs.controller.VisioController"
            stylesheets="@../../../../style/style.css"
            styleClass="visio-root"
            prefWidth="1200.0"
            prefHeight="820.0"
            minWidth="960.0"
            minHeight="700.0">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT"
              styleClass="visio-header"
              BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label text="VISIOCONFÉRENCE" styleClass="visio-header-title"/>
                        <Label text="Organisez vos réunions audio/vidéo rapidement et proprement."
                               styleClass="visio-header-subtitle"/>
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button mnemonicParsing="false"
                        onAction="#rafraichirListeReunions"
                        styleClass="visio-btn-header"
                        text="Actualiser"/>
            </children>
            <padding>
                <Insets top="16.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
        </HBox>
    </top>

    <!-- CONTENU -->
    <center>
        <VBox spacing="18.0"
              fillWidth="true"
              styleClass="visio-content"
              minWidth="0.0"
              minHeight="0.0">
            <padding>
                <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
            </padding>

            <children>
                <Label text="Rejoignez une réunion instantanée ou planifiez une visio avec votre équipe."
                       styleClass="visio-subtitle"
                       wrapText="true"/>

                <!-- SPLITPANE = beaucoup plus stable qu'un HBox + ScrollPane -->
                <SplitPane dividerPositions="0.34"
                           VBox.vgrow="ALWAYS"
                           minHeight="0.0"
                           minWidth="0.0"
                           styleClass="visio-splitpane">

                    <items>

                        <!-- COLONNE GAUCHE -->
                        <VBox spacing="20.0"
                              minWidth="340.0"
                              prefWidth="420.0"
                              maxWidth="520.0"
                              fillWidth="true"
                              styleClass="visio-left-column">

                            <children>

                                <!-- Rejoindre -->
                                <VBox spacing="14.0" styleClass="visio-card">
                                    <children>
                                        <Label text="Rejoindre un salon" styleClass="visio-card-title"/>

                                        <Label text="Saisissez l'identifiant du salon pour lancer la visio dans votre navigateur."
                                               styleClass="visio-field-label"
                                               wrapText="true"/>

                                        <FlowPane hgap="12.0"
                                                  vgap="12.0"
                                                  prefWrapLength="360.0">
                                            <children>
                                                <TextField fx:id="txtRoomName"
                                                           promptText="Ex : reunion-equipe, cellule-crise..."
                                                           styleClass="visio-field"
                                                           prefWidth="260.0"/>

                                                <Button fx:id="btnRejoindre"
                                                        mnemonicParsing="false"
                                                        onAction="#demanderConnexion"
                                                        styleClass="visio-btn-primary"
                                                        text="Rejoindre"/>
                                            </children>
                                        </FlowPane>
                                    </children>
                                </VBox>

                                <!-- Planifier -->
                                <VBox spacing="14.0"
                                      styleClass="visio-card"
                                      VBox.vgrow="ALWAYS"
                                      minHeight="0.0">
                                    <children>

                                        <Label text="Programmer une réunion" styleClass="visio-card-title"/>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="Identifiant du salon" styleClass="visio-field-label"/>
                                                <TextField fx:id="txtPlanifRoomName"
                                                           promptText="Nom unique de la salle"
                                                           styleClass="visio-field"
                                                           maxWidth="1.7976931348623157E308"/>
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="Date" styleClass="visio-field-label"/>
                                                <DatePicker fx:id="datePlanif"
                                                            promptText="jj/mm/aaaa"
                                                            styleClass="visio-field"
                                                            prefHeight="40.0"
                                                            maxWidth="1.7976931348623157E308"
                                                            stylesheets="@/style/popup.css"/>
                                            </children>
                                        </VBox>

                                        <FlowPane hgap="14.0" vgap="12.0" prefWrapLength="360.0">
                                            <children>
                                                <VBox spacing="8.0" prefWidth="150.0">
                                                    <children>
                                                        <Label text="Heure" styleClass="visio-field-label"/>
                                                        <Spinner fx:id="spinnerHeure"
                                                                 editable="true"
                                                                 styleClass="visio-field"
                                                                 prefHeight="40.0"
                                                                 maxWidth="1.7976931348623157E308"/>
                                                    </children>
                                                </VBox>

                                                <VBox spacing="8.0" prefWidth="150.0">
                                                    <children>
                                                        <Label text="Min" styleClass="visio-field-label"/>
                                                        <Spinner fx:id="spinnerMinute"
                                                                 editable="true"
                                                                 styleClass="visio-field"
                                                                 prefHeight="40.0"
                                                                 maxWidth="1.7976931348623157E308"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </FlowPane>

                                        <VBox spacing="8.0" VBox.vgrow="ALWAYS" minHeight="0.0">
                                            <children>
                                                <Label text="Inviter des collaborateurs"
                                                       styleClass="visio-field-label"/>

                                                <FlowPane hgap="10.0" vgap="10.0" prefWrapLength="360.0">
                                                    <children>
                                                        <TextField fx:id="txtRechercheInvite"
                                                                   promptText="Rechercher un nom..."
                                                                   styleClass="visio-field"
                                                                   prefWidth="240.0"/>

                                                        <Button mnemonicParsing="false"
                                                                onAction="#ajouterInviteManuel"
                                                                styleClass="visio-btn-primary"
                                                                text="➕ Ajouter"/>
                                                    </children>
                                                </FlowPane>

                                                <ScrollPane fitToWidth="true"
                                                            pannable="true"
                                                            minHeight="78.0"
                                                            prefHeight="96.0"
                                                            maxHeight="120.0"
                                                            styleClass="visio-badges-scroll">
                                                    <content>
                                                        <FlowPane fx:id="flowPaneInvitesBadges"
                                                                  hgap="8.0"
                                                                  vgap="8.0"
                                                                  styleClass="visio-badges-pane"/>
                                                    </content>
                                                </ScrollPane>
                                            </children>
                                        </VBox>

                                        <Button fx:id="btnPlanifier"
                                                mnemonicParsing="false"
                                                onAction="#planifierReunion"
                                                styleClass="visio-btn-primary-wide"
                                                text="Enregistrer la planification"
                                                maxWidth="1.7976931348623157E308"/>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>

                        <!-- COLONNE DROITE -->
                        <VBox spacing="14.0"
                              styleClass="visio-card visio-right-column"
                              minWidth="0.0"
                              minHeight="0.0"
                              VBox.vgrow="ALWAYS">

                            <children>
                                <Label text="Mes réunions" styleClass="visio-card-title"/>

                                <TabPane fx:id="tabPaneReunions"
                                         tabClosingPolicy="UNAVAILABLE"
                                         minWidth="0.0"
                                         minHeight="0.0"
                                         VBox.vgrow="ALWAYS">

                                    <tabs>
                                        <Tab text="À venir / En cours">
                                            <content>
                                                <VBox spacing="10.0"
                                                      styleClass="visio-tab-content"
                                                      minWidth="0.0"
                                                      minHeight="0.0"
                                                      VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <TableView fx:id="tableReunionsActives"
                                                                   styleClass="visio-table"
                                                                   minWidth="0.0"
                                                                   minHeight="0.0"
                                                                   VBox.vgrow="ALWAYS">
                                                            <columns>
                                                                <TableColumn fx:id="colRoomName" text="Salon"/>
                                                                <TableColumn fx:id="colStatut" text="État"/>
                                                                <TableColumn fx:id="colDate" text="Date prévue"/>
                                                            </columns>
                                                            <columnResizePolicy>
                                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                                            </columnResizePolicy>
                                                            <placeholder>
                                                                <Label text="Aucune réunion programmée pour le moment."
                                                                       styleClass="visio-placeholder"/>
                                                            </placeholder>
                                                        </TableView>

                                                        <Pagination fx:id="paginationReunions"
                                                                    pageCount="1"
                                                                    maxPageIndicatorCount="5"/>
                                                    </children>
                                                </VBox>
                                            </content>
                                        </Tab>

                                        <Tab text="Historique">
                                            <content>
                                                <VBox spacing="10.0"
                                                      styleClass="visio-tab-content"
                                                      minWidth="0.0"
                                                      minHeight="0.0"
                                                      VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <TableView fx:id="tableReunionsArchives"
                                                                   styleClass="visio-table"
                                                                   minWidth="0.0"
                                                                   minHeight="0.0"
                                                                   VBox.vgrow="ALWAYS">
                                                            <columns>
                                                                <TableColumn fx:id="colRoomNameArchive" text="Salon"/>
                                                                <TableColumn fx:id="colStatutArchive" text="État"/>
                                                                <TableColumn fx:id="colDateArchive"
                                                                             text="Date terminée"/>
                                                            </columns>
                                                            <columnResizePolicy>
                                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                                            </columnResizePolicy>
                                                            <placeholder>
                                                                <Label text="Aucun historique disponible."
                                                                       styleClass="visio-placeholder"/>
                                                            </placeholder>
                                                        </TableView>
                                                    </children>
                                                </VBox>
                                            </content>
                                        </Tab>
                                    </tabs>
                                </TabPane>

                                <HBox alignment="CENTER_RIGHT">
                                    <children>
                                        <Button fx:id="btnRejoindreSelection"
                                                mnemonicParsing="false"
                                                onAction="#rejoindreSalonSelectionne"
                                                styleClass="visio-btn-primary"
                                                text="Rejoindre la sélection (Actif)"/>
                                    </children>
                                </HBox>

                                <HBox styleClass="visio-status-bar">
                                    <children>
                                        <Label fx:id="lblStatut"
                                               text="Prêt."
                                               wrapText="true"
                                               styleClass="visio-status-text"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </items>
                </SplitPane>
            </children>
        </VBox>
    </center>
</BorderPane>