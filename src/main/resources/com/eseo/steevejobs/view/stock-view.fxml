<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="768.0" prefWidth="1200.0"
            styleClass="root-pane"
            stylesheets="@../../../../style/style.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="com.eseo.steevejobs.controller.StockController">

    <center>
        <VBox style="-fx-background-color: #DDE8FF;" BorderPane.alignment="CENTER">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" prefHeight="80.0"
                  style="-fx-background-color: #82A9F1;">
                <padding><Insets left="20.0" right="20.0"/></padding>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold;
                  -fx-font-family: 'Comic Sans MS';"
                       text="&lt; STOCKS" textFill="WHITE"/>
            </HBox>

            <!-- CORPS -->
            <HBox VBox.vgrow="ALWAYS" spacing="0">

                <!-- PANNEAU GAUCHE -->
                <VBox HBox.hgrow="ALWAYS" spacing="12"
                      style="-fx-background-color: #DDE8FF;">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                    <!-- Barre de recherche -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField"
                                   promptText="Recherche de produit..."
                                   prefHeight="38"
                                   HBox.hgrow="ALWAYS"
                                   onKeyReleased="#onSearchRealTime"
                                   style="-fx-background-radius: 8; -fx-border-radius: 8;
                                          -fx-border-color: #CCCCCC; -fx-background-color: white;
                                          -fx-padding: 6 10;"/>
                        <Button text="Rafraîchir" onAction="#onRefresh"
                                style="-fx-background-color: white; -fx-text-fill: #5584D5;
                                       -fx-border-color: #5584D5; -fx-border-width: 1;
                                       -fx-background-radius: 8; -fx-border-radius: 8;
                                       -fx-padding: 8 14; -fx-cursor: hand;"/>
                        <Button text="+ Nouveau Produit" onAction="#onNouveauProduit"
                                style="-fx-background-color: #5584D5; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-border-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Tableau dans carte blanche -->
                    <VBox VBox.vgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 10;
                                 -fx-border-color: #CCCCCC; -fx-border-radius: 10;
                                 -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.08),8,0,0,3);">

                        <TableView fx:id="tableProduits" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: transparent;
                                          -fx-background-radius: 10;
                                          -fx-border-color: transparent;">
                            <columns>
                                <TableColumn fx:id="colId"        text="ID"          prefWidth="55"/>
                                <TableColumn fx:id="colNom"       text="Nom Produit" prefWidth="190"/>
                                <TableColumn fx:id="colCategorie" text="Catégorie"   prefWidth="110"/>
                                <TableColumn fx:id="colReference" text="Référence"   prefWidth="110"/>
                                <TableColumn fx:id="colQuantite"  text="Quantité"    prefWidth="110"/>
                                <TableColumn fx:id="colStatut"    text="Status"      prefWidth="140"/>
                            </columns>
                        </TableView>

                        <!-- Compteur -->
                        <HBox alignment="CENTER_LEFT" spacing="8"
                              style="-fx-padding: 8 16; -fx-background-color: white;
                                     -fx-background-radius: 0 0 10 10;
                                     -fx-border-color: #EEEEEE transparent transparent transparent;
                                     -fx-border-width: 1;">
                            <Label fx:id="labelNbProduits" text="0 produit(s)"
                                   style="-fx-font-size: 12px; -fx-text-fill: #7a849e;"/>
                        </HBox>
                    </VBox>

                </VBox>

                <!-- FICHE PRODUIT -->
                <VBox fx:id="fichePanel" spacing="0" minWidth="280" maxWidth="300"
                      style="-fx-background-color: white;
                             -fx-border-color: #CCCCCC transparent transparent transparent;
                             -fx-border-width: 0 0 0 1;">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <Label text="Fiche Produit"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;
                                  -fx-font-family: 'Comic Sans MS'; -fx-text-fill: #1e2545;
                                  -fx-padding: 0 0 10 0;"/>

                    <StackPane alignment="CENTER"
                               style="-fx-background-color: #82A9F1; -fx-background-radius: 40;
                                      -fx-min-width: 64; -fx-min-height: 64;
                                      -fx-max-width: 64; -fx-max-height: 64; -fx-padding: 10;">
                        <Label text="📦" style="-fx-font-size: 26px;"/>
                    </StackPane>

                    <Label fx:id="ficheNom" text="—"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #1e2545; -fx-padding: 10 0 2 0;
                                  -fx-wrap-text: true;"/>

                    <Region style="-fx-background-color: #DDE8FF;
                                   -fx-min-height: 1; -fx-max-height: 1;">
                        <VBox.margin><Insets top="10" bottom="10"/></VBox.margin>
                    </Region>

                    <Label text="Détails"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;
                                  -fx-text-fill: #1e2545; -fx-padding: 0 0 6 0;"/>

                    <VBox spacing="8"
                          style="-fx-background-color: #DDE8FF; -fx-background-radius: 8;
                                 -fx-border-radius: 8; -fx-border-color: #BBCFEF;
                                 -fx-border-width: 1; -fx-padding: 10 12;">
                        <HBox>
                            <Label text="Prix HT : "
                                   style="-fx-font-size: 12px; -fx-text-fill: #5567a0; -fx-min-width: 95;"/>
                            <Label fx:id="fichePrix" text="—"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e2545;"/>
                        </HBox>
                        <HBox>
                            <Label text="TVA : "
                                   style="-fx-font-size: 12px; -fx-text-fill: #5567a0; -fx-min-width: 95;"/>
                            <Label fx:id="ficheTva" text="—"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e2545;"/>
                        </HBox>
                        <HBox>
                            <Label text="Quantité : "
                                   style="-fx-font-size: 12px; -fx-text-fill: #5567a0; -fx-min-width: 95;"/>
                            <Label fx:id="ficheQte" text="—"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e2545;"/>
                        </HBox>
                        <HBox>
                            <Label text="Poids : "
                                   style="-fx-font-size: 12px; -fx-text-fill: #5567a0; -fx-min-width: 95;"/>
                            <Label fx:id="fichePoids" text="—"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e2545;"/>
                        </HBox>
                        <HBox>
                            <Label text="Seuil alerte : "
                                   style="-fx-font-size: 12px; -fx-text-fill: #5567a0; -fx-min-width: 95;"/>
                            <Label fx:id="ficheSeuilAlerte" text="—"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e2545;"/>
                        </HBox>
                        <HBox>
                            <Label text="Statut : "
                                   style="-fx-font-size: 12px; -fx-text-fill: #5567a0; -fx-min-width: 95;"/>
                            <Label fx:id="ficheStatut" text="—"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>

                    <Region style="-fx-background-color: #DDE8FF;
                                   -fx-min-height: 1; -fx-max-height: 1;">
                        <VBox.margin><Insets top="14" bottom="10"/></VBox.margin>
                    </Region>

                    <Label text="Actions rapides"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;
                                  -fx-text-fill: #1e2545; -fx-padding: 0 0 6 0;"/>

                    <VBox spacing="8">
                        <VBox.margin><Insets top="4"/></VBox.margin>
                        <Button fx:id="btnFicheEntree" text="Entrée (+)"
                                maxWidth="Infinity" onAction="#onFicheEntree"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-border-radius: 8; -fx-padding: 9 0; -fx-cursor: hand;"/>
                        <Button fx:id="btnFicheSortie" text="Sortie (−)"
                                maxWidth="Infinity" onAction="#onFicheSortie"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-border-radius: 8; -fx-padding: 9 0; -fx-cursor: hand;"/>
                        <Button fx:id="btnFicheAjuster" text="Ajuster (=)"
                                maxWidth="Infinity" onAction="#onFicheAjuster"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-border-radius: 8; -fx-padding: 9 0; -fx-cursor: hand;"/>
                    </VBox>

                </VBox>

            </HBox>
        </VBox>
    </center>
</BorderPane>