<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="768.0" prefWidth="1200.0"
            style="-fx-background-color: #f4f5f7;"
            stylesheets="@../../../../style/style.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="com.eseo.steevejobs.controller.StockController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0"
              style="-fx-background-color: #82A9F1;">
            <padding><Insets left="20.0" right="20.0"/></padding>
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;
                          -fx-font-family: 'Comic Sans MS';"
                   text="&lt; STOCKS" textFill="WHITE"/>
        </HBox>
    </top>

    <!-- CORPS -->
    <center>
        <HBox spacing="15.0">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>

            <!-- PANNEAU GAUCHE — Tableau -->
            <VBox HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></padding>

                <!-- Barre de recherche -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField"
                               promptText="Recherche de produit..."
                               prefHeight="38"
                               HBox.hgrow="ALWAYS"
                               onKeyReleased="#onSearchRealTime"
                               style="-fx-background-radius: 8; -fx-border-radius: 8;
                                      -fx-border-color: #CCCCCC; -fx-background-color: white;
                                      -fx-padding: 6 10;"/>
                    <Button text="Rafraîchir" onAction="#onRefresh"
                            style="-fx-background-color: white; -fx-text-fill: #5584D5;
                                   -fx-border-color: #5584D5; -fx-border-width: 1;
                                   -fx-background-radius: 8; -fx-border-radius: 8;
                                   -fx-padding: 8 14; -fx-cursor: hand;"/>
                    <Button text="+ Nouveau Produit" onAction="#onNouveauProduit"
                            style="-fx-background-color: #5584D5; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 8;
                                   -fx-border-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;"/>
                </HBox>

                <!-- Espace -->
                <VBox prefHeight="15.0" minHeight="15.0"/>

                <!-- Tableau -->
                <TableView fx:id="tableProduits" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent;
                                  -fx-background-radius: 10;
                                  -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colId"       text="ID"          prefWidth="55"/>
                        <TableColumn fx:id="colNom"      text="Nom Produit" prefWidth="190"/>
                        <TableColumn fx:id="colQuantite" text="Quantité"    prefWidth="110"/>
                        <TableColumn fx:id="colStatut"   text="Status"      prefWidth="140"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucun produit trouvé"
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 14px;"/>
                    </placeholder>
                </TableView>

                <!-- Compteur -->
                <HBox alignment="CENTER_LEFT" prefHeight="36.0">
                    <Label fx:id="labelNbProduits" text="0 produit(s)"
                           style="-fx-font-size: 12px; -fx-text-fill: #7a849e;"/>
                </HBox>

            </VBox>

            <!-- PANNEAU DROIT — Fiche Produit -->
            <VBox fx:id="fichePanel" spacing="0" minWidth="280" maxWidth="300"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <!-- En-tête de la fiche -->
                <VBox alignment="CENTER_LEFT" minHeight="55.0"
                      style="-fx-background-color: #82A9F1; -fx-background-radius: 10 10 0 0;">
                    <padding><Insets left="20.0" top="14.0" bottom="14.0"/></padding>
                    <Label text="Fiche Produit"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;
                                  -fx-font-family: 'Comic Sans MS'; -fx-text-fill: white;"/>
                </VBox>

                <VBox spacing="12.0">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="15.0"/></padding>

                    <!-- Nom du produit -->
                    <Label fx:id="ficheNom" text="Aucun produit sélectionné"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #1e2545; -fx-wrap-text: true;"/>

                    <Region style="-fx-background-color: #DDE8FF; -fx-min-height: 1; -fx-max-height: 1;"/>

                    <!-- Détails -->
                    <Label text="Détails"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;
                                  -fx-text-fill: #4B78CC;"/>

                    <VBox spacing="8"
                          style="-fx-background-color: #DDE8FF; -fx-background-radius: 8;
                                 -fx-border-radius: 8; -fx-border-color: #BBCFEF;
                                 -fx-border-width: 1; -fx-padding: 10 12;">
                        <HBox>
                            <Label text="Prix HT : "
                                   style="-fx-font-size: 12px; -fx-text-fill: #5567a0; -fx-min-width: 95;"/>
                            <Label fx:id="fichePrix" text="—"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e2545;"/>
                        </HBox>
                        <HBox>
                            <Label text="TVA : "
                                   style="-fx-font-size: 12px; -fx-text-fill: #5567a0; -fx-min-width: 95;"/>
                            <Label fx:id="ficheTva" text="—"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e2545;"/>
                        </HBox>
                        <HBox>
                            <Label text="Quantité : "
                                   style="-fx-font-size: 12px; -fx-text-fill: #5567a0; -fx-min-width: 95;"/>
                            <Label fx:id="ficheQte" text="—"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e2545;"/>
                        </HBox>
                        <HBox>
                            <Label text="Poids : "
                                   style="-fx-font-size: 12px; -fx-text-fill: #5567a0; -fx-min-width: 95;"/>
                            <Label fx:id="fichePoids" text="—"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e2545;"/>
                        </HBox>
                        <HBox>
                            <Label text="Seuil alerte : "
                                   style="-fx-font-size: 12px; -fx-text-fill: #5567a0; -fx-min-width: 95;"/>
                            <Label fx:id="ficheSeuilAlerte" text="—"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e2545;"/>
                        </HBox>
                        <HBox>
                            <Label text="Statut : "
                                   style="-fx-font-size: 12px; -fx-text-fill: #5567a0; -fx-min-width: 95;"/>
                            <Label fx:id="ficheStatut" text="—"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>

                    <Region style="-fx-background-color: #DDE8FF; -fx-min-height: 1; -fx-max-height: 1;"/>

                    <!-- Actions -->
                    <Label text="Actions rapides"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;
                                  -fx-text-fill: #4B78CC;"/>

                    <VBox spacing="8">
                        <Button fx:id="btnFicheEntree" text="Entrée (+)"
                                maxWidth="Infinity" onAction="#onFicheEntree"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-border-radius: 8; -fx-padding: 9 0; -fx-cursor: hand;"/>
                        <Button fx:id="btnFicheSortie" text="Sortie (−)"
                                maxWidth="Infinity" onAction="#onFicheSortie"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-border-radius: 8; -fx-padding: 9 0; -fx-cursor: hand;"/>
                        <Button fx:id="btnFicheAjuster" text="Ajuster (=)"
                                maxWidth="Infinity" onAction="#onFicheAjuster"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-border-radius: 8; -fx-padding: 9 0; -fx-cursor: hand;"/>
                        <Button fx:id="btnFicheModifier" text="Modifier ✎ "
                                maxWidth="Infinity" onAction="#onFicheModifier"
                                style="-fx-background-color: #5584D5; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-border-radius: 8; -fx-padding: 9 0; -fx-cursor: hand;"/>
                    </VBox>

                </VBox>
            </VBox>

        </HBox>
    </center>

</BorderPane>
